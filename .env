# Required API keys. Fill in your own values before running the program.
DASHSCOPE_API_KEY=
API_KEY=

# OpenAI-compatible chat model endpoint.
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# Optional DashScope embedding/rerank overrides.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=2048
# RERANK_MODEL=qwen3-rerank

# Optional retrieval/research overrides.
# RESEARCH_RERANK_CHUNK_LIMIT=500
# RESEARCH_FINAL_CHUNK_LIMIT=100
# RESEARCH_CONTEXT_TOKEN_BUDGET=120000
# RESEARCH_REPORT_MIN_CHARS=500
